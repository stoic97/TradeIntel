# /etc/scope/staging.env — the shape only. The real file is root-owned, mode 600, and is
# never committed:  install -m 600 -o root -g root /dev/null /etc/scope/staging.env
# then fill it on the box. Every value below is a placeholder.

# Staging's OWN session key, never production's: a production cookie is then invalid on
# staging and the reverse. Generate a fresh one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SCOPE_SECRET_KEY=generate-a-new-one-do-not-copy-production

# The SAME file key as production (copy it from /etc/scope/scope.env). Staging restores
# production's encrypted file store; with another key every copied file is unreadable.
SCOPE_FILE_KEY=same-as-production

# Staging's own database, inside the only directory the unit lets it write.
SCOPE_DB=sqlite:////srv/scope-staging/data/scope.db

# Staging's own file store, restored from production's by refresh-staging.sh.
SCOPE_FILES=/srv/scope-staging/data/files

# 1, as production: staging must behave exactly like production (TD-024 file-map refusal included).
SCOPE_PRODUCTION=1

# The same list as production, so the same people can open /admin on staging.
ADMIN_LOGIN_IDS=same-as-production
