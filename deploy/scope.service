# /etc/systemd/system/scope.service
#
# One process, as ADR-007 says. No worker, no queue: reconstruction of a few
# thousand rows takes seconds, and a second process would be supervision for no
# v1 benefit.

[Unit]
Description=PlusEV Scope
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=scope
Group=scope
WorkingDirectory=/srv/scope

# The keys live here, root-owned, 0600, and are excluded from backups. A backup
# holding both the encrypted files and the key that opens them is one theft, not
# two.
EnvironmentFile=/etc/scope/scope.env

ExecStart=/usr/local/bin/uv run --frozen --no-group research \
    uvicorn services.production.api.app:create_app --factory \
    --host 127.0.0.1 --port 8000

# Caddy is the only thing that talks to it; it never listens on a public address.
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/scope/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
